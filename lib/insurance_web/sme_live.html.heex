<div class="min-h-screen bg-gray-50 py-12">
  <div class="max-w-7xl mx-auto px-6">

    <!-- Page Header -->
    <div class="text-center mb-14">
      <div class="inline-flex items-center bg-orange-100 text-orange-700 px-4 py-2 rounded-full text-sm font-medium mb-4">
         SME Insurance
      </div>
      <h1 class="text-4xl font-bold text-gray-900 mb-4" style="font-family: 'DM Serif Display', serif;">
        SME Business Insurance
      </h1>
      <p class="text-lg text-gray-500 max-w-2xl mx-auto">
        Protect your business against fire, theft, liability, and business interruption.
        Tailored covers for small and medium enterprises across all sectors.
      </p>
    </div>

    <!-- Cover Cards Grid -->
    <div class="grid md:grid-cols-3 gap-6 mb-12">

      <%= for {key, cover} <- InsuranceWeb.SmeLive.sme_covers() do %>
        <div class={"bg-white rounded-2xl shadow-sm p-6 border-2 transition-all duration-200 card-hover " <> if @selected_cover == key, do: "border-orange-500 shadow-lg", else: "border-gray-100 hover:border-orange-200"}>
          <div class="flex items-center justify-between mb-3">
            <%= if key == "sme_shield" do %>
              <span class="bg-green-100 text-green-700 px-2 py-1 rounded-full text-xs font-semibold">Most Popular</span>
            <% else %>
              <span class="bg-gray-100 text-gray-500 px-2 py-1 rounded-full text-xs">Cover</span>
            <% end %>
            <%= if @selected_cover == key do %>
              <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-semibold">Selected</span>
            <% end %>
          </div>
          <h3 class="text-base font-bold text-gray-900 mb-2"><%= cover.label %></h3>
          <p class="text-gray-500 text-xs mb-4 leading-relaxed"><%= cover.description %></p>
          <button phx-click="select_cover" phx-value-cover={key}
            class={"w-full py-2 rounded-xl font-semibold text-sm transition-all " <> if @selected_cover == key, do: "bg-green-600 text-white", else: "bg-gray-100 hover:bg-green-600 hover:text-white text-gray-700"}>
            <%= if @selected_cover == key, do: "✔ Cover Selected", else: "Get Quote" %>
          </button>
        </div>
      <% end %>

    </div>

    <!-- Quote Form -->
    <%= if @selected_cover do %>
      <div class="bg-white shadow-xl rounded-2xl p-10 max-w-xl mx-auto border border-gray-100">
        <h3 class="text-2xl font-bold text-gray-900 mb-2 text-center">Generate Your SME Quote</h3>
        <p class="text-gray-500 text-sm text-center mb-2">
          Cover: <span class="font-semibold text-orange-700">
            <%= (InsuranceWeb.SmeLive.sme_covers()[@selected_cover] || %{label: ""}).label %>
          </span>
        </p>
        <p class="text-gray-400 text-xs text-center mb-8">
          <span class="text-orange-600 font-medium">Login required</span> to generate your quote.
        </p>

        <%= if @show_login_prompt do %>
          <div class="bg-orange-50 border border-orange-200 rounded-xl p-5 mb-6 text-center">
            <p class="text-orange-800 font-semibold mb-1">Login Required</p>
            <p class="text-orange-600 text-sm mb-4">Please log in or create an account to generate and save your SME quote.</p>
            <.link navigate="/users/log_in" class="bg-orange-600 text-white px-6 py-2 rounded-xl font-semibold hover:bg-orange-700 transition-all inline-block">
              Log in to Continue →
            </.link>
          </div>
        <% end %>

        <form phx-submit="generate_quote" class="space-y-5">

          <input type="hidden" name="cover_key" value={@selected_cover} />

          <!-- Business Details -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Business / Company Name</label>
            <input type="text" name="business_name" required placeholder="e.g. Wanjiku Enterprises Ltd"
              class="w-full border border-gray-200 rounded-xl p-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none text-gray-900"/>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Business Sector</label>
            <select name="sector"
              class="w-full border border-gray-200 rounded-xl p-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none bg-white text-gray-900">
              <%= for {key, sector} <- InsuranceWeb.SmeLive.sectors() do %>
                <option value={key}><%= sector.label %></option>
              <% end %>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Business Registration Number</label>
            <input type="text" name="reg_number" required placeholder="e.g. PVT-A12345678"
              class="w-full border border-gray-200 rounded-xl p-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none text-gray-900"/>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">KRA PIN (Business)</label>
            <input type="text" name="kra_pin" required placeholder="e.g. P051234567A"
              class="w-full border border-gray-200 rounded-xl p-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none text-gray-900"/>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Contact Name</label>
            <input type="text" name="contact_name" required placeholder="e.g. Mary Otieno"
              class="w-full border border-gray-200 rounded-xl p-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none text-gray-900"/>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Phone Number</label>
            <input type="tel" name="phone" required placeholder="e.g. 0712 345 678"
              class="w-full border border-gray-200 rounded-xl p-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none text-gray-900"/>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Business Location / Town</label>
            <input type="text" name="location" required placeholder="e.g. Westlands, Nairobi"
              class="w-full border border-gray-200 rounded-xl p-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none text-gray-900"/>
          </div>

          <!-- Cover-specific fields -->
          <%= if @selected_cover in ["fire_perils", "burglary", "business_int", "sme_shield"] do %>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">
                <%= cond do
                  @selected_cover == "fire_perils"  -> "Sum Insured — Premises, Stock & Equipment (KES)"
                  @selected_cover == "burglary"     -> "Sum Insured — Stock, Cash & Assets (KES)"
                  @selected_cover == "business_int" -> "Annual Gross Profit / Indemnity Value (KES)"
                  @selected_cover == "sme_shield"   -> "Total Sum Insured — All Assets (KES)"
                  true -> "Sum Insured (KES)"
                end %>
              </label>
              <input type="number" name="sum_insured" required min="100000" placeholder="e.g. 2,000,000"
                class="w-full border border-gray-200 rounded-xl p-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none text-gray-900"/>
              <p class="text-xs text-gray-400 mt-1">Enter the full replacement value of your insured assets. Underinsurance may affect claims.</p>
            </div>
          <% end %>

          <%= if @selected_cover == "public_liability" do %>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Estimated Annual Turnover (KES)</label>
              <select name="turnover"
                class="w-full border border-gray-200 rounded-xl p-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none bg-white text-gray-900">
                <option value="5000000">Up to KES 5,000,000</option>
                <option value="10000000">Up to KES 10,000,000</option>
                <option value="20000000">Up to KES 20,000,000</option>
                <option value="50000000">Up to KES 50,000,000</option>
                <option value="100000000">Up to KES 100,000,000</option>
              </select>
            </div>
          <% end %>

          <%= if @selected_cover == "gpa" do %>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Number of Employees</label>
              <input type="number" name="employees" required min="1" placeholder="e.g. 10"
                class="w-full border border-gray-200 rounded-xl p-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none text-gray-900"/>
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Capital Sum Insured per Employee (KES)</label>
              <select name="capital_per_employee"
                class="w-full border border-gray-200 rounded-xl p-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none bg-white text-gray-900">
                <option value="500000">KES 500,000 per employee</option>
                <option value="1000000">KES 1,000,000 per employee</option>
                <option value="2000000">KES 2,000,000 per employee</option>
                <option value="3000000">KES 3,000,000 per employee</option>
                <option value="5000000">KES 5,000,000 per employee</option>
              </select>
            </div>
          <% end %>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Number of Years in Operation</label>
            <select name="years_in_operation"
              class="w-full border border-gray-200 rounded-xl p-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none bg-white text-gray-900">
              <option value="0">Less than 1 year (Start-up)</option>
              <option value="1">1 – 3 years</option>
              <option value="3">3 – 5 years</option>
              <option value="5">5 – 10 years</option>
              <option value="10">Over 10 years</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Previous Claims in Last 3 Years?</label>
            <select name="previous_claims"
              class="w-full border border-gray-200 rounded-xl p-3 focus:ring-2 focus:ring-orange-500 focus:border-transparent outline-none bg-white text-gray-900">
              <option value="none">No claims</option>
              <option value="one">1 claim</option>
              <option value="two">2 claims</option>
              <option value="three_plus">3 or more claims</option>
            </select>
          </div>

          <button type="submit" class="w-full text-white py-3 rounded-xl font-semibold bg-green-600 hover:bg-green-700 transition-all">
            Calculate SME Premium →
          </button>
        </form>
      </div>
    <% end %>

    <!-- Quote Result -->
    <%= if @quote_data do %>
      <div class="mt-8 max-w-xl mx-auto">
        <div class="bg-gradient-to-br from-green-600 to-green-700 rounded-2xl p-8 text-white shadow-xl">
          <p class="text-green-200 text-sm font-medium mb-2 text-center">Estimated Annual Premium</p>
          <p class="text-5xl font-bold mb-1 text-center">KES <%= InsuranceWeb.SmeLive.format_number(@quote_data.total_annual) %></p>
          <p class="text-green-200 text-sm mb-2 text-center">≈ KES <%= InsuranceWeb.SmeLive.format_number(@quote_data.monthly) %>/month</p>
          <p class="text-green-200 text-xs mb-6 text-center">Cover: <%= @quote_data.cover %> | Sector: <%= @quote_data.sector %></p>

          <div class="grid grid-cols-2 gap-4 mb-6">
            <div class="bg-white/10 rounded-xl p-4 text-center">
              <p class="text-green-200 text-xs mb-1">Base Premium</p>
              <p class="font-bold">KES <%= InsuranceWeb.SmeLive.format_number(@quote_data.base_premium) %></p>
            </div>
            <div class="bg-white/10 rounded-xl p-4 text-center">
              <p class="text-green-200 text-xs mb-1">Stamp Duty & Levy</p>
              <p class="font-bold">KES <%= InsuranceWeb.SmeLive.format_number(@quote_data.levy) %></p>
            </div>
          </div>

          <p class="text-green-300 text-xs mb-6 text-center">
            Indicative premium only. Final premium subject to full risk assessment and underwriting by
            a licensed insurer regulated by the Insurance Regulatory Authority (IRA).
          </p>

          <%= if @saved do %>
            <div class="bg-white/20 rounded-xl py-3 px-6 font-semibold text-white text-center">
              ✔ Quote Saved Successfully!
            </div>
          <% else %>
            <%= if @current_user do %>
              <button phx-click="save_quote" class="w-full bg-white text-green-700 px-8 py-3 rounded-xl font-bold hover:bg-green-50 transition-all shadow">
                Save This Quote →
              </button>
            <% else %>
              <div class="space-y-3 text-center">
                <p class="text-green-200 text-sm">Log in to save this quote to your account</p>
                <.link navigate="/users/log_in" class="bg-white text-green-700 px-8 py-3 rounded-xl font-bold hover:bg-green-50 transition-all shadow inline-block">
                  Log in to Save →
                </.link>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</div>

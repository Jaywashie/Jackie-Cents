<!DOCTYPE html>
<html lang="en" style="scrollbar-gutter: stable;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · JackieCents">
      <%= assigns[:page_title] || "Insurance" %>
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Serif+Display&display=swap" rel="stylesheet" />
    <style>
      * { font-family: 'Plus Jakarta Sans', sans-serif; }
      .font-display { font-family: 'DM Serif Display', serif; }
      .nav-glass {
        background: rgba(20, 83, 45, 0.97);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }
      .hero-gradient {
        background: linear-gradient(135deg, #14532d 0%, #166534 40%, #15803d 100%);
      }
      .card-hover {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.12);
      }
      .btn-primary {
        background: linear-gradient(135deg, #16a34a, #15803d);
        transition: all 0.2s ease;
      }
      .btn-primary:hover {
        background: linear-gradient(135deg, #15803d, #166534);
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(22, 163, 74, 0.4);
      }
      .badge-active {
        background: linear-gradient(135deg, #dcfce7, #bbf7d0);
        color: #166534;
      }
      .badge-expired {
        background: linear-gradient(135deg, #fee2e2, #fecaca);
        color: #991b1b;
      }

      /* ── Mobile menu ── */
      #mobile-menu {
        display: none;
        flex-direction: column;
        background: rgba(15, 60, 32, 0.98);
        border-top: 1px solid rgba(255,255,255,0.08);
      }
      #mobile-menu.open {
        display: flex;
      }

      /* Hamburger icon animation */
      #hamburger-btn .bar {
        display: block;
        width: 22px;
        height: 2px;
        background: white;
        border-radius: 2px;
        transition: transform 0.25s ease, opacity 0.25s ease;
        transform-origin: center;
      }
      #hamburger-btn.open .bar:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
      }
      #hamburger-btn.open .bar:nth-child(2) {
        opacity: 0;
        transform: scaleX(0);
      }
      #hamburger-btn.open .bar:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
      }

      /* Mobile nav link style */
      .mobile-nav-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 24px;
        color: rgba(187, 247, 208, 0.9);
        font-size: 0.9rem;
        font-weight: 500;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        transition: background 0.15s ease, color 0.15s ease;
        text-decoration: none;
      }
      .mobile-nav-link:hover {
        background: rgba(255,255,255,0.07);
        color: white;
      }
      .mobile-nav-link .nav-icon {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: rgba(255,255,255,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0;
      }
      .mobile-nav-section {
        padding: 10px 24px 4px;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(134, 239, 172, 0.5);
      }
      .mobile-auth-row {
        padding: 16px 24px;
        display: flex;
        gap: 10px;
        border-top: 1px solid rgba(255,255,255,0.08);
      }

      /* Dropdown nav */
      .nav-dropdown {
        position: relative;
      }
      .nav-dropdown-menu {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        min-width: 220px;
        background: #14532d;
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 12px;
        padding: 6px;
        z-index: 100;
        box-shadow: 0 10px 30px rgba(0,0,0,0.3);
      }
      .nav-dropdown:hover .nav-dropdown-menu,
      .nav-dropdown:focus-within .nav-dropdown-menu {
        display: block;
      }
      .nav-dropdown-menu a {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 12px;
        color: rgba(187, 247, 208, 0.9);
        font-size: 0.82rem;
        font-weight: 500;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.15s ease, color 0.15s ease;
        white-space: nowrap;
      }
      .nav-dropdown-menu a:hover {
        background: rgba(255,255,255,0.1);
        color: white;
      }
      .nav-dropdown-btn {
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .nav-dropdown-btn svg {
        transition: transform 0.2s ease;
      }
      .nav-dropdown:hover .nav-dropdown-btn svg {
        transform: rotate(180deg);
      }
    </style>
  </head>

  <!-- NAVBAR -->
  <nav class="nav-glass sticky top-0 z-50 shadow-lg">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex justify-between items-center h-16">

        <!-- Logo -->
        <.link navigate="/" class="flex items-center space-x-2 group">
          <div class="w-8 h-8 bg-white rounded-lg flex items-center justify-center shadow">
            <svg class="w-5 h-5 text-green-700" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd"/>
            </svg>
          </div>
          <span class="text-xl font-bold text-white tracking-tight">
            Jackie<span class="text-green-300">Cents</span>
          </span>
        </.link>

        <!-- Desktop Nav Links -->
        <div class="hidden lg:flex items-center space-x-1">
          <.link navigate="/" class="text-green-100 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg text-sm font-medium transition-all">Home</.link>

          <!-- Insurance dropdown -->
          <div class="nav-dropdown">
            <button class="nav-dropdown-btn text-green-100 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg text-sm font-medium transition-all">
              Insurance
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="nav-dropdown-menu">
              <a href="/medical">🏥 Medical Cover</a>
              <a href="/life">❤️ Life Insurance</a>
              <a href="/motor">🚗 Motor Cover</a>
              <a href="/wiba">👷 WIBA</a>
              <a href="/sme-insurance">🏬 SME Insurance</a>
              <a href="/travel">✈️ Travel Insurance</a>
              <a href="/marine">🚢 Marine &amp; Cargo</a>
              <a href="/group-life">👥 Group Life</a>
              <a href="/group-last-expense">🕊️ Group Last Expense</a>
              <a href="/amani-shield">🛡️ Amani Shield</a>
            </div>
          </div>

          <!-- Investments dropdown -->
          <div class="nav-dropdown">
            <button class="nav-dropdown-btn text-green-100 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg text-sm font-medium transition-all">
              Investments
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="nav-dropdown-menu">
              <a href="/pension">🏦 Pension Plan</a>
              <a href="/money-market">💰 Money Market Fund</a>
              <a href="/unit-trust">📈 Unit Trust Funds</a>
            </div>
          </div>

          <!-- Health -->
          <.link navigate="/afya-tele" class="text-green-100 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg text-sm font-medium transition-all"> Afya Tele</.link>

          <%= if @current_user do %>
            <.link navigate="/my-quotes" class="text-green-100 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg text-sm font-medium transition-all">My Quotes</.link>
          <% end %>
          <%= if @current_user && @current_user.role == "admin" do %>
            <.link navigate="/admin" class="text-green-100 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg text-sm font-medium transition-all">⚙️ Admin</.link>
          <% end %>
        </div>

        <!-- Right side: auth + hamburger -->
        <div class="flex items-center gap-3">
          <!-- Desktop auth -->
          <div class="hidden lg:flex items-center space-x-3">
            <%= if @current_user do %>
              <span class="text-green-200 text-sm">
                👋 <%= if @current_user.first_name, do: "#{@current_user.first_name} #{@current_user.last_name}", else: @current_user.email %>
              </span>
              <.link href={~p"/users/settings"} class="text-green-100 hover:text-white text-sm font-medium transition-all">Settings</.link>
              <.link href={~p"/users/log_out"} method="delete"
                class="bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded-lg text-sm font-semibold border border-white/20 transition-all">
                Log out
              </.link>
            <% else %>
              <.link href={~p"/users/register"} class="text-green-100 hover:text-white text-sm font-medium transition-all">Register</.link>
              <.link href={~p"/users/log_in"}
                class="bg-white text-green-700 px-4 py-2 rounded-lg text-sm font-semibold hover:bg-green-50 transition-all shadow">
                Log in
              </.link>
            <% end %>
          </div>

          <!-- Hamburger button (visible below lg) -->
          <button id="hamburger-btn"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="lg:hidden flex flex-col justify-center gap-[5px] w-9 h-9 rounded-lg hover:bg-white/10 items-center transition-all"
            onclick="toggleMobileMenu()">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
          </button>
        </div>

      </div>
    </div>

    <!-- Mobile Menu Panel -->
    <div id="mobile-menu" role="navigation" aria-label="Mobile navigation">

      <!-- Insurance section -->
      <span class="mobile-nav-section">Insurance</span>
      <a href="/" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">🏠</span> Home
      </a>
      <a href="/medical" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">🏥</span> Medical Cover
      </a>
      <a href="/life" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">🛡️</span> Life Insurance
      </a>
      <a href="/motor" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">🚗</span> Motor Cover
      </a>
      <a href="/wiba" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">🦺</span> WIBA
      </a>
      <a href="/sme-insurance" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">🏢</span> SME Insurance
      </a>
      <a href="/travel" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">✈️</span> Travel Insurance
      </a>
      <a href="/marine" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">🚢</span> Marine &amp; Cargo
      </a>
      <a href="/group-life" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">👥</span> Group Life
      </a>
      <a href="/group-last-expense" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">🕊️</span> Group Last Expense
      </a>
      <a href="/amani-shield" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">🛡️</span> Amani Shield
      </a>

      <!-- Health & Wellness -->
      <span class="mobile-nav-section">Health & Wellness</span>
      <a href="/afya-tele" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">📱</span> Afya Tele
      </a>

      <!-- Investments section -->
      <span class="mobile-nav-section">Investments</span>
      <a href="/pension" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">🏦</span> Pension Plan
      </a>
      <a href="/money-market" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">💰</span> Money Market Fund
      </a>
      <a href="/unit-trust" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">📊</span> Unit Trust Funds
      </a>

      <!-- Account section -->
      <span class="mobile-nav-section">Account</span>
      <a href="/my-quotes" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">📋</span> My Quotes
      </a>
      <a href="/users/settings" class="mobile-nav-link" onclick="closeMobileMenu()">
        <span class="nav-icon">⚙️</span> Settings
      </a>

      <!-- Mobile auth buttons -->
      <div class="mobile-auth-row">
        <%= if @current_user do %>
          <span class="text-green-300 text-sm self-center flex-1">
            👋 <%= if @current_user.first_name, do: @current_user.first_name, else: @current_user.email %>
          </span>
          <.link href={~p"/users/log_out"} method="delete"
            class="bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded-lg text-sm font-semibold border border-white/20 transition-all">
            Log out
          </.link>
        <% else %>
          <.link href={~p"/users/register"}
            class="flex-1 text-center bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded-lg text-sm font-semibold border border-white/20 transition-all">
            Register
          </.link>
          <.link href={~p"/users/log_in"}
            class="flex-1 text-center bg-white text-green-700 px-4 py-2 rounded-lg text-sm font-semibold hover:bg-green-50 transition-all shadow">
            Log in
          </.link>
        <% end %>
      </div>

    </div>
  </nav>

  <body class="bg-gray-50 antialiased min-h-screen flex flex-col">
    <%= @inner_content %>
  </body>

  <!-- FOOTER -->
  <footer class="bg-gray-900 text-gray-300 mt-auto">
    <div class="max-w-7xl mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-4 gap-10">

      <!-- Brand -->
      <div class="md:col-span-1">
        <div class="flex items-center space-x-2 mb-4">
          <div class="w-9 h-9 bg-green-600 rounded-lg flex items-center justify-center shadow">
            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944z" clip-rule="evenodd"/>
            </svg>
          </div>
          <span class="text-white font-bold text-xl">JackieCents</span>
        </div>
        <p class="text-gray-400 text-sm leading-relaxed mb-6">
          Plan today for a secure tomorrow. Trusted insurance solutions for every stage of life.
        </p>
        <!-- Social Icons -->
        <div class="flex items-center gap-3">
          <a href="https://instagram.com/jackiejosh1" target="_blank"
            class="w-9 h-9 bg-gray-800 hover:bg-pink-600 rounded-lg flex items-center justify-center transition-colors"
            aria-label="Instagram">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2zm8.5 1.5h-8.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5a4.25 4.25 0 0 0 4.25-4.25v-8.5A4.25 4.25 0 0 0 16.25 3.5z"/>
              <path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 1.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7z"/>
              <circle cx="17.5" cy="6.5" r="1"/>
            </svg>
          </a>
          <a href="https://wa.me/254721343980" target="_blank"
            class="w-9 h-9 bg-gray-800 hover:bg-green-600 rounded-lg flex items-center justify-center transition-colors"
            aria-label="WhatsApp">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.04 2C6.58 2 2.14 6.44 2.14 11.9c0 2.11.55 4.16 1.6 5.97L2 22l4.27-1.72a9.82 9.82 0 0 0 5.77 1.84h.01c5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2z"/>
            </svg>
          </a>
          <a href="https://www.tiktok.com/@jackiecent" target="_blank"
            class="w-9 h-9 bg-gray-800 hover:bg-gray-600 rounded-lg flex items-center justify-center transition-colors"
            aria-label="TikTok">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.6 2h2.2a5.4 5.4 0 0 0 3.7 3.7v2.2a7.6 7.6 0 0 1-3.7-1v7.4a5.6 5.6 0 1 1-5.6-5.6c.4 0 .8 0 1.2.1v2.3a3.4 3.4 0 1 0 2.2 3.2V2z"/>
            </svg>
          </a>
          <a href="https://www.youtube.com/@JackieCents" target="_blank"
            class="w-9 h-9 bg-gray-800 hover:bg-red-600 rounded-lg flex items-center justify-center transition-colors"
            aria-label="YouTube">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.7 31.7 0 0 0 0 12a31.7 31.7 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.7 31.7 0 0 0 24 12a31.7 31.7 0 0 0-.5-5.8zM9.8 15.5v-7l6.2 3.5-6.2 3.5z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Insurance Products -->
      <div>
        <h3 class="text-white font-semibold mb-5 text-sm uppercase tracking-widest">Insurance</h3>
        <ul class="space-y-2 text-sm">
          <li><.link navigate="/medical" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> Medical Cover</.link></li>
          <li><.link navigate="/life" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> Life Insurance</.link></li>
          <li><.link navigate="/motor" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> Motor Cover</.link></li>
          <li><.link navigate="/wiba" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> WIBA Cover</.link></li>
          <li><.link navigate="/sme-insurance" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> SME Insurance</.link></li>
          <li><.link navigate="/travel" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> Travel Insurance</.link></li>
          <li><.link navigate="/marine" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> Marine &amp; Cargo</.link></li>
          <li><.link navigate="/group-life" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> Group Life</.link></li>
          <li><.link navigate="/group-last-expense" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> Group Last Expense</.link></li>
          <li><.link navigate="/amani-shield" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> Amani Shield</.link></li>
        </ul>
      </div>

      <!-- Investments + Health -->
      <div>
        <h3 class="text-white font-semibold mb-5 text-sm uppercase tracking-widest">Investments &amp; Health</h3>
        <ul class="space-y-2 text-sm">
          <li><.link navigate="/pension" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> Pension Plan</.link></li>
          <li><.link navigate="/money-market" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> Money Market Fund</.link></li>
          <li><.link navigate="/unit-trust" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> Unit Trust Funds</.link></li>
          <li><.link navigate="/afya-tele" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> Afya Tele</.link></li>
        </ul>
        <h3 class="text-white font-semibold mt-7 mb-4 text-sm uppercase tracking-widest">Company</h3>
        <ul class="space-y-2 text-sm">
          <li><.link navigate="/" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> Home</.link></li>
          <li><.link navigate="/my-quotes" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> My Quotes</.link></li>
          <li><.link navigate="/users/register" class="hover:text-green-400 transition-colors flex items-center gap-2"><span class="text-green-600">→</span> Get Started</.link></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-white font-semibold mb-5 text-sm uppercase tracking-widest">Contact Us</h3>
        <ul class="space-y-4 text-sm">
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-green-500 shrink-0">📍</span>
            <span class="text-gray-400">Kilimani,Jabavu Heights Apartments</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="mt-0.5 text-green-500 shrink-0">✉️</span>
            <a href="mailto:JackieCents23@gmail.com"
